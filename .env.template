# Database Connection
DATABASE_URL=

# Global
PORT=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# SQL Database Configutation
SQL_USER=
SQL_PASSWORD=
SQL_HOST=
SQL_DATABASE=
SQL_PORT=

# CORS: orígenes permitidos separados por comas (vacío = abierto a todos)
CORS_ORIGINS=

# API externa de bodycams (el token solo vive en el servidor)
BODYCAM_API_URL=
BODYCAM_API_TOKEN=

# Llaves para sistemas externos que consumen /camaras|radios|bodycams/cercanas (cabecera x-api-key), separadas por comas
INTEGRATION_API_KEYS=

# Usuarios "solo app móvil": duración del access token y del refresh (por defecto 15m y 30 días)
MOBILE_ACCESS_TOKEN_TTL=
MOBILE_REFRESH_TTL_DAYS=

# Android Key Attestation en la primera vinculación: required (por defecto) | off (solo pruebas locales)
DEVICE_ATTESTATION=
# Paquete de la app y SHA-256 del certificado de firma del APK (de `eas credentials`), separados por coma
ANDROID_PACKAGE_NAME=
ANDROID_SIGNING_CERT_SHA256=
# Rechazar celulares con bootloader desbloqueado (true por defecto)
ATTESTATION_REQUIRE_LOCKED_BOOTLOADER=
