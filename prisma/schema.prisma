generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Brand {
  DAHUA
  HIKVISION
}

enum Camera {
  LPR
  C180
  C360
}

enum Color {
  GREEN
  YELLOW
}

enum Mode {
  FIXED
  DOME
  BOTH
}

enum Rol {
  SUPERADMIN
  ADMINISTRATOR
  CODISEC
  SUPERVISOR
  OPERATOR
  VIEWER
  PNP
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum CaseStatus {
  INVESTIGATING
  REFERRED
  CLOSED
}

model Activity {
  id                    String                @id @default(uuid())
  address               String?
  description           String
  act_type              String
  representative        String?
  observation           String?
  latitude              Float
  longitude             Float
  done_at               DateTime
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Defense {
  id                    String                @id @default(uuid())
  address               String
  place                 String
  latitude              Float
  longitude             Float
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Comisaria {
  id         String    @id @default(uuid())
  name       String
  latitude   Float
  longitude  Float
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Jurisdiction {
  id                    String                @id @default(uuid())
  name                  String
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Municipal {
  id                    String                @id @default(uuid())
  name                  String                @unique
  address               String
  camera                Camera
  latitude              Float
  longitude             Float
  angle                 Float?
  radius                Float?
  buttom                Boolean               @default(false)
  megaphone             Boolean               @default(false)
  // Cámara caída (ej. sin energía): no se dibuja su pin en el mapa, pero sigue contando
  map_hidden            Boolean               @default(false)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Communal {
  id                    String                @id @default(uuid())
  address               String
  brand                 Brand
  mode                  Mode
  neighbor              String
  latitude              Float
  longitude             Float
  user                  String?
  password              String?
  serial                String?
  phone                 String?
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Typology {
  id                    String                @id @default(uuid())
  name                  String
  map_id                Int
  incidence_id          Int
  case_type             String
  case_subtype          String
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Stop {
  id                    String                @id @default(uuid())
  name                  String
  address               String
  latitude              Float
  longitude             Float
  authorized            Boolean               @default(false)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model CampaignPoint {
  id          String    @id @default(uuid())
  name        String
  description String?
  category    String
  lat         Float?
  lng         Float?
  polygon     Json?
  geom_type   String    @default("POINT")
  color       String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
}

model Sustenance {
  id                    String                @id @default(uuid())
  name                  String
  address               String
  latitude              Float
  longitude             Float
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model User {
  id                    String                @id @default(uuid())
  username              String                @unique
  password              String
  name                  String
  lastname              String
  email                 String?               @unique
  dni                   String?               @unique
  phone                 String?               @unique
  token                 String?
  max_sessions          Int                   @default(1)
  // Solo puede ingresar desde la app móvil vinculada (firma con llave del Keystore)
  mobile_only           Boolean               @default(false)
  device_public_key     String?
  device_info           String?
  device_bound_at       DateTime?
  // Horario de acceso (hora de Lima, "HH:MM"). Ambos null = sin restricción.
  // access_days: 1 = lunes … 7 = domingo (día en que empieza el turno)
  access_start          String?               @db.VarChar(5)
  access_end            String?               @db.VarChar(5)
  access_days           Int[]                 @default([])
  // Muestra el pin de "mi ubicación" en el mapa (lo habilita el administrador)
  show_location_pin     Boolean               @default(false)
  custom_role_id        String
  custom_role           CustomRole            @relation(fields: [custom_role_id], references: [id])
  sessions              UserSession[]
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model UserSession {
  id                    String                @id @default(uuid())
  user_id               String
  user                  User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_agent            String?
  ip                    String?
  created_at            DateTime              @default(now())
  revoked_at            DateTime?
  revoked_reason        String?
  // Sesión iniciada desde la app móvil con firma del dispositivo
  is_mobile             Boolean               @default(false)
  refresh_token_hash    String?
  refresh_expires_at    DateTime?

  @@index([user_id])
}

// Reto de un solo uso que la app firma con la llave del dispositivo (login / refresh)
model DeviceChallenge {
  id                    String                @id @default(uuid())
  username              String
  purpose               String
  nonce                 String
  expires_at            DateTime
  used_at               DateTime?
  created_at            DateTime              @default(now())

  @@index([expires_at])
}

model CustomRole {
  id                      String                    @id @default(uuid())
  name                    String                    @unique
  system_slug             String?                   @unique
  description             String?
  allowed_jurisdictions   String[]                  @default([])
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @updatedAt
  deleted_at              DateTime?
  users                   User[]
  module_permissions      RoleModulePermission[]
  layer_permissions       RoleLayerPermission[]
}

model RoleModulePermission {
  id             String     @id @default(uuid())
  custom_role_id String
  custom_role    CustomRole @relation(fields: [custom_role_id], references: [id], onDelete: Cascade)
  module_key     String
  can_access     Boolean    @default(true)
  can_create     Boolean    @default(false)
  can_edit       Boolean    @default(false)
  can_delete     Boolean    @default(false)
  // Campos que el rol ve en el MAPA (capa). Vacio = sin restriccion.
  visible_fields String[]   @default([])
  // Campos que el rol ve en el MODULO administrativo y su Excel.
  // Es independiente de visible_fields a proposito: el panel de gestion maneja
  // datos sensibles (telefono del vecino, usuario, password) que no van al mapa.
  export_fields  String[]   @default([])

  @@unique([custom_role_id, module_key])
}

model RoleLayerPermission {
  id             String     @id @default(uuid())
  custom_role_id String
  custom_role    CustomRole @relation(fields: [custom_role_id], references: [id], onDelete: Cascade)
  layer_key      String

  @@unique([custom_role_id, layer_key])
}

model IncidenceType {
  id         String             @id @default(uuid())
  name       String             @unique
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  deleted_at DateTime?
  subtypes   IncidenceSubtype[]
}

model IncidenceSubtype {
  id         String              @id @default(uuid())
  name       String
  type_id    String
  type       IncidenceType       @relation(fields: [type_id], references: [id])
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt
  deleted_at DateTime?
  modalities IncidenceModality[]

  @@unique([name, type_id])
}

model IncidenceModality {
  id          String           @id @default(uuid())
  name        String
  subtype_id  String
  subtype     IncidenceSubtype @relation(fields: [subtype_id], references: [id])
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  deleted_at  DateTime?
  incidences  PnpIncidence[]

  @@unique([name, subtype_id])
}

model PnpIncidence {
  id               String             @id @default(uuid())
  description      String
  modality_id      String?
  modality         IncidenceModality? @relation(fields: [modality_id], references: [id])
  incidence_type   String?
  address          String?
  latitude         Float
  longitude        Float
  jurisdiction     String
  shift            Shift?
  complaint_number String?
  police_station   String
  case_status      CaseStatus?
  occurred_at      DateTime
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  deleted_at       DateTime?
}

model Waste {
  id                    String                @id @default(uuid())
  name                  String
  latitude              Float
  longitude             Float
  color                 Color                 @default(GREEN)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  entity       String
  entity_id    String
  changes      Json?
  performed_by String?
  created_at   DateTime @default(now())
}

model GpsZone {
  id          String    @id @default(uuid())
  nombre      String
  descripcion String?
  geojson     String
  color       String    @default("#6366f1")
  activo      Boolean   @default(true)
  radios_issi String    @default("[]")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
}

// ─── Patrullaje y despacho (prueba piloto, 2026-11) ─────────────────────────
// La "móvil" se identifica por la radio TETRA fija (ISSI de Dolphin).
// Aún no hay catálogo de móviles: código y tipo se copian de Dolphin al crear.

enum PatrolPlanSource {
  AUTO    // ruta inteligente generada desde el motor predictivo
  MANUAL  // ruta creada por orden de subgerencia / alcaldía
}

enum PatrolPlanStatus {
  ACTIVO
  REEMPLAZADO  // una ruta manual o una regeneración la sustituyó
  CERRADO
  ANULADO
}

model PatrolPlan {
  id             String           @id @default(uuid())
  date           DateTime         @db.Date
  shift          Shift
  source         PatrolPlanSource
  status         PatrolPlanStatus @default(ACTIVO)
  unit_issi      String
  unit_code      String?
  unit_type      String?
  // Jurisdicción donde estaba la móvil al generar la ruta (polígono GeoJSON)
  jurisdiction_id Int?
  jurisdiction   String?
  title          String?
  // Ruta manual: quién la ordenó (cargo y nombre) y documento de sustento
  ordered_by     String?
  order_ref      String?
  notes          String?
  // Ruta trazada por calles ([lat, lng][]) y resumen
  route          Json?
  distance_m     Int?
  duration_s     Int?
  model_version  String?
  created_by     String?
  stops          PatrolStop[]
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  @@index([date, shift])
  @@index([unit_issi])
}

model PatrolStop {
  id          String     @id @default(uuid())
  plan_id     String
  plan        PatrolPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  order       Int
  lat         Float
  lng         Float
  cell_id     String?
  level       String?
  reason      String?
  dwell_min   Int        @default(10)
  // Cumplimiento medido con el histórico GPS de la radio
  visited_at  DateTime?
  dwell_s     Int?
  min_dist_m  Int?
  checked_at  DateTime?

  @@index([plan_id])
}

enum DispatchStatus {
  ASIGNADO
  EN_LUGAR
  CERRADO
  CANCELADO
}

model Dispatch {
  id             String         @id @default(uuid())
  // Incidencia del Sistema de Incidencias CECOM (o punto marcado en el mapa)
  incident_id    String?
  incident_code  String?
  incident_type  String?
  lat            Float
  lng            Float
  reference      String?
  // Recurso enviado: MOVIL (radio fija del vehículo), RADIO (portátil) o BODYCAM.
  // unit_issi guarda el ISSI de la radio o el código de la bodycam.
  resource_type  String         @default("MOVIL")
  unit_issi      String
  unit_code      String?
  rank           Int?
  eta_s          Int?
  distance_m     Int?
  status         DispatchStatus @default(ASIGNADO)
  assigned_by    String?
  assigned_at    DateTime       @default(now())
  arrived_at     DateTime?
  closed_at      DateTime?
  notes          String?
  // Varias unidades a una misma emergencia comparten group_id (inc-<id de incidencia> o uuid del punto marcado)
  group_id       String?
  // Hora en que se registró la incidencia en el Sistema de Incidencias (tramo recepción -> despacho)
  incident_registered_at DateTime?
  // Prioridad del tipo al momento de despachar: ALTA | MEDIA | BAJA
  priority       String?
  // Resultado al cerrar o cancelar: ATENDIDO, FALSA_ALARMA, DERIVADO_PNP, DERIVADO_BOMBEROS, DERIVADO_SAMU,
  // NO_UBICADO, REASIGNADO, SIN_NOVEDAD, OTRO
  result         String?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@index([status])
  @@index([unit_issi])
  @@index([group_id])
}

// "Fuera de servicio" marcado por la torre: la unidad no se sugiere ni recibe ruta hasta que vuelva.
// key = "<MOVIL|RADIO|BODYCAM>:<issi o código>"
model UnitServiceStatus {
  key             String   @id
  fuera_servicio  Boolean  @default(true)
  motivo          String?
  updated_by      String?
  updated_at      DateTime @updatedAt
}

// Alertas automáticas del turno (unidad detenida, fuera de su jurisdicción, dejó de reportar, jurisdicción sin móvil).
// Se abren y cierran solas; la torre puede marcarlas como atendidas. Quedan como historial.
model PatrolAlert {
  id              String    @id @default(uuid())
  type            String              // DETENIDA | FUERA_JURISDICCION | SIN_REPORTE | JURISDICCION_SIN_MOVIL
  resource_type   String?             // MOVIL | RADIO | BODYCAM (null para jurisdicción)
  unit_issi       String?
  unit_code       String?
  jurisdiction    String?
  lat             Float?
  lng             Float?
  message         String
  started_at      DateTime  @default(now())
  ended_at        DateTime?
  acknowledged_by String?
  acknowledged_at DateTime?

  @@index([ended_at])
  @@index([started_at])
}

// Prioridad y nombre corto por tipo de incidencia (configurable desde Despacho). Si un tipo no está aquí,
// se usa la regla por defecto de tipos-incidencia.ts (según el grupo del motor predictivo).
model IncidentTypeConfig {
  tipo        String   @id        // descripción del tipo tal como llega del Sistema de Incidencias
  corto       String              // nombre corto para listas y mapa
  prioridad   String              // ALTA | MEDIA | BAJA
  categoria   String?             // PERSONA | PATRIMONIO | AUXILIO | TRANSITO | TRANQUILIDAD | COSTUMBRES | ORDENANZAS | OTROS
  updated_by  String?
  updated_at  DateTime @updatedAt
}

// Asignación LOCAL de una radio TETRA a una móvil (solo SIVECAM, no se escribe en Dolphin).
// Sirve para ver la radio en el mapa con el símbolo y el código de la móvil.
model RadioAssignment {
  issi        String   @id
  unit_code   String          // código de la móvil en SIVECAM, p. ej. "ORION 91"
  unit_kind   String          // CAMIONETA | MOTO | A_PIE
  plate       String?
  notes       String?
  updated_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}
