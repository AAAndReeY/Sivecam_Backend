generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Brand {
  DAHUA
  HIKVISION
}

enum Camera {
  LPR
  C180
  C360
}

enum Color {
  GREEN
  YELLOW
}

enum Mode {
  FIXED
  DOME
  BOTH
}

enum Rol {
  ADMINISTRATOR
  SUPERVISOR
  OPERATOR
  VIEWER
}

model Defense {
  id                    String                @id @default(uuid())
  address               String
  place                 String
  latitude              Float
  longitude             Float
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Jurisdiction {
  id                    String                @id @default(uuid())
  name                  String
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Municipal {
  id                    String                @id @default(uuid())
  name                  String                @unique
  address               String
  camera                Camera
  latitude              Float
  longitude             Float
  angle                 Float?
  radius                Float?
  buttom                Boolean               @default(false)
  megaphone             Boolean               @default(false)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Communal {
  id                    String                @id @default(uuid())
  address               String
  brand                 Brand
  mode                  Mode
  neighbor              String
  latitude              Float
  longitude             Float
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Typology {
  id                    String                @id @default(uuid())
  name                  String
  map_id                Int
  incidence_id          Int
  case_type             String
  case_subtype          String
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Stop {
  id                    String                @id @default(uuid())
  name                  String
  address               String
  latitude              Float
  longitude             Float
  authorized            Boolean               @default(false)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Sustenance {
  id                    String                @id @default(uuid())
  name                  String
  address               String
  latitude              Float
  longitude             Float
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model User {
  id                    String                @id @default(uuid())
  username              String                @unique
  password              String
  name                  String
  lastname              String
  email                 String?               @unique
  dni                   String?               @unique
  phone                 String?               @unique
  token                 String?
  rol                   Rol
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Waste {
  id                    String                @id @default(uuid())
  name                  String
  latitude              Float
  longitude             Float
  color                 Color                 @default(GREEN)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}
