generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Brand {
  DAHUA
  HIKVISION
}

enum Camera {
  LPR
  C180
  C360
}

enum Color {
  GREEN
  YELLOW
}

enum Mode {
  FIXED
  DOME
  BOTH
}

enum Rol {
  SUPERADMIN
  ADMINISTRATOR
  CODISEC
  SUPERVISOR
  OPERATOR
  VIEWER
  PNP
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum CaseStatus {
  INVESTIGATING
  REFERRED
  CLOSED
}

model Activity {
  id                    String                @id @default(uuid())
  address               String?
  description           String
  act_type              String
  representative        String?
  observation           String?
  latitude              Float
  longitude             Float
  done_at               DateTime
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Defense {
  id                    String                @id @default(uuid())
  address               String
  place                 String
  latitude              Float
  longitude             Float
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Comisaria {
  id         String    @id @default(uuid())
  name       String
  latitude   Float
  longitude  Float
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Jurisdiction {
  id                    String                @id @default(uuid())
  name                  String
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Municipal {
  id                    String                @id @default(uuid())
  name                  String                @unique
  address               String
  camera                Camera
  latitude              Float
  longitude             Float
  angle                 Float?
  radius                Float?
  buttom                Boolean               @default(false)
  megaphone             Boolean               @default(false)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Communal {
  id                    String                @id @default(uuid())
  address               String
  brand                 Brand
  mode                  Mode
  neighbor              String
  latitude              Float
  longitude             Float
  user                  String?
  password              String?
  serial                String?
  phone                 String?
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Typology {
  id                    String                @id @default(uuid())
  name                  String
  map_id                Int
  incidence_id          Int
  case_type             String
  case_subtype          String
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model Stop {
  id                    String                @id @default(uuid())
  name                  String
  address               String
  latitude              Float
  longitude             Float
  authorized            Boolean               @default(false)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model CampaignPoint {
  id          String    @id @default(uuid())
  name        String
  description String?
  category    String
  lat         Float?
  lng         Float?
  polygon     Json?
  geom_type   String    @default("POINT")
  color       String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
}

model Sustenance {
  id                    String                @id @default(uuid())
  name                  String
  address               String
  latitude              Float
  longitude             Float
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model User {
  id                    String                @id @default(uuid())
  username              String                @unique
  password              String
  name                  String
  lastname              String
  email                 String?               @unique
  dni                   String?               @unique
  phone                 String?               @unique
  token                 String?
  custom_role_id        String
  custom_role           CustomRole            @relation(fields: [custom_role_id], references: [id])
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model CustomRole {
  id                      String                    @id @default(uuid())
  name                    String                    @unique
  system_slug             String?                   @unique
  description             String?
  allowed_jurisdictions   String[]                  @default([])
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @updatedAt
  deleted_at              DateTime?
  users                   User[]
  module_permissions      RoleModulePermission[]
  layer_permissions       RoleLayerPermission[]
}

model RoleModulePermission {
  id             String     @id @default(uuid())
  custom_role_id String
  custom_role    CustomRole @relation(fields: [custom_role_id], references: [id], onDelete: Cascade)
  module_key     String
  can_access     Boolean    @default(true)
  can_create     Boolean    @default(false)
  can_edit       Boolean    @default(false)
  can_delete     Boolean    @default(false)
  visible_fields String[]   @default([])

  @@unique([custom_role_id, module_key])
}

model RoleLayerPermission {
  id             String     @id @default(uuid())
  custom_role_id String
  custom_role    CustomRole @relation(fields: [custom_role_id], references: [id], onDelete: Cascade)
  layer_key      String

  @@unique([custom_role_id, layer_key])
}

model IncidenceType {
  id         String             @id @default(uuid())
  name       String             @unique
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  deleted_at DateTime?
  subtypes   IncidenceSubtype[]
}

model IncidenceSubtype {
  id         String              @id @default(uuid())
  name       String
  type_id    String
  type       IncidenceType       @relation(fields: [type_id], references: [id])
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt
  deleted_at DateTime?
  modalities IncidenceModality[]

  @@unique([name, type_id])
}

model IncidenceModality {
  id          String           @id @default(uuid())
  name        String
  subtype_id  String
  subtype     IncidenceSubtype @relation(fields: [subtype_id], references: [id])
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  deleted_at  DateTime?
  incidences  PnpIncidence[]

  @@unique([name, subtype_id])
}

model PnpIncidence {
  id               String             @id @default(uuid())
  description      String
  modality_id      String?
  modality         IncidenceModality? @relation(fields: [modality_id], references: [id])
  incidence_type   String?
  address          String?
  latitude         Float
  longitude        Float
  jurisdiction     String
  shift            Shift?
  complaint_number String?
  police_station   String
  case_status      CaseStatus?
  occurred_at      DateTime
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  deleted_at       DateTime?
}

model Waste {
  id                    String                @id @default(uuid())
  name                  String
  latitude              Float
  longitude             Float
  color                 Color                 @default(GREEN)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  deleted_at            DateTime?
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  entity       String
  entity_id    String
  changes      Json?
  performed_by String?
  created_at   DateTime @default(now())
}
